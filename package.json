{
  "name": "project-server",
  "version": "1.8.0",
  "private": true,
  "description": "This is the default project server template used for all United Solutions projects.",
  "module": "index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev nodemon",
    "dev-test": "cross-env NODE_ENV=dev-test nodemon",
    "start1": "cross-env NODE_ENV=dev node --import @swc-node/register/esm-register src/index.ts",
    "start": "node --import @swc-node/register/esm-register src/index.ts",
    "start:dev": "cross-env NODE_ENV=dev ts-node -r tsconfig-paths/register ./src/index.ts",
    "start:test": "cross-env NODE_ENV=test nodemon",
    "start-prod": "cross-env NODE_ENV=production node --import @swc-node/register/esm-register src/index.ts",
    "prod": "cross-env NODE_ENV=production node --import @swc-node/register/esm-register src/index.ts",
    "test-site": "cross-env NODE_ENV=testing node ./dist/index",
    "build": "rm -rf ./dist && tsc && cp ./app/lib ./dist/app -r | true",
    "coverage": "nyc mocha -exit  -s 0",
    "test-unit": "cross-env NODE_ENV=dev mocha",
    "lint": "npm run lint:common && npm run lint:app",
    "lint:fix": "tslint --fix --project ./tsconfig.json -e ./**/node_modules/**/* ./**/*.ts",
    "lint:common": "tslint --project ./tsconfig.json ./src/**/*.ts",
    "lint:common:fix": "tslint --fix --project ./tsconfig.json ./src/**/*.ts",
    "lint:app": "rm -rf ./app/node_modules && tslint -e ./app/node_modules/**/* ./app/**/*.ts",
    "lint:app:fix": "tslint --fix --project ./tsconfig.json -e ./app/node_modules/**/* ./app/**/*.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.12.0",
    "@swc/helpers": "^0.5.17",
    "@tsed/common": "^8.20.1",
    "@tsed/components-scan": "^8.20.1",
    "@tsed/core": "^8.20.1",
    "@tsed/di": "^8.20.1",
    "@tsed/engines": "^8.20.1",
    "@tsed/exceptions": "^8.20.1",
    "@tsed/json-mapper": "^8.20.1",
    "@tsed/logger": "^8.0.4",
    "@tsed/platform-express": "^8.20.1",
    "@tsed/platform-log-request": "^8.20.1",
    "@tsed/platform-middlewares": "^8.20.1",
    "@tsed/platform-multer": "^8.28.8",
    "@tsed/platform-params": "^8.20.1",
    "@tsed/schema": "^8.20.1",
    "ajv": "^8.11.0",
    "ajv-formats": "^2.1.1",
    "archiver": "^4.0.2",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "class-transformer": "^0.4.0",
    "compression": "^1.7.4",
    "config": "^3.3.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.2",
    "es6-shim": "^0.35.6",
    "express": "^4.21.1",
    "follow-redirects": "^1.15.9",
    "form-data": "^3.0.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "method-override": "^3.0.0",
    "module-alias": "^2.2.2",
    "mongodb": "^5.6.0",
    "mongodb-memory-server": "^11.3.0",
    "node-fetch": "^2.6.7",
    "node-schedule": "^1.3.3",
    "pako": "^2.1.0",
    "re2": "^1.20.5",
    "rxjs": "^6.6.0",
    "stream": "0.0.2",
    "stream-buffers": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.1.2",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/chai": "^4.3.1",
    "@types/clamav.js": "^0.12.0",
    "@types/compression": "^1.7.0",
    "@types/config": "0.0.36",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.6",
    "@types/express": "^4.17.6",
    "@types/express-session": "^1.17.0",
    "@types/follow-redirects": "^1.14.1",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/lodash": "^4.14.182",
    "@types/method-override": "0.0.31",
    "@types/node": "^18.0.0",
    "@types/node-schedule": "^1.3.0",
    "@types/pako": "^1.0.4",
    "@types/pizzip": "^3.0.2",
    "@types/swagger-schema-official": "^2.0.21",
    "chai": "^4.3.6",
    "nodemon": "^3.0.1",
    "ts-node-dev": "^2.0.0",
    "ttypescript": "^1.5.15",
    "typescript": "^5.8.3",
    "typescript-transform-paths": "^3.4.7"
  },
  "_moduleAliases": {
    "@app": "app",
    "@src": "src"
  }
}
